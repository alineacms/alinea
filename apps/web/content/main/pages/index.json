    {
      "_id": "3JjOvjfZnce3zPbm7f5f9BQ9m5y",
      "_index": "a1",
      "_type": "Spotlight",
      "heading": "How Alinea differs",
      "intro": "Like other git-based CMSs, Alinea stores content in your repository. It also publishes without a rebuild, previews drafts with one component and installs four packages.",
      "label": "Faster since 2.0",
      "title": "Published content goes live without a rebuild",
      "text": "Every publish is a git commit. Your running site picks up the new content right away instead of waiting for CI. Commits that only change content can skip the build, and pages can be revalidated after each publish.",
      "checks": [
        {
          "_id": "3JjOvlCbfqtfJRQgTSWPG7kkkgb",
          "_index": "a0",
          "_type": "Item",
          "text": "Content syncs to your running site on every commit"
        },
        {
          "_id": "3JjOvpiuDNx3c5gLru8ss88irfa",
          "_index": "a1",
          "_type": "Item",
          "text": "Commits that only change content can skip the build"
        },
        {
          "_id": "3JjOvkoP5Rz7JVNyAyCcOhMYj9A",
          "_index": "a2",
          "_type": "Item",
          "text": "Code changes deploy as before"
        }
