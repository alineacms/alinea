      "filename": "app/blog/[slug]/page.tsx",
      "code": "export default async function Post({params}) {\n  const {slug} = await params\n  const post = await cms.get({\n    type: BlogPost,\n    url: `/blog/${slug}`,\n    select: {\n      title: BlogPost.title,\n      publishDate: BlogPost.publishDate,\n      body: BlogPost.body\n    }\n  })\n  return <Article {...post} />\n}",
