    {
      "_id": "3JjOvjfZnce3zPbm7f5f9BQ9m5y",
      "_index": "a1",
      "_type": "Spotlight",
      "heading": "Where Alinea shines",
      "intro": "The things you won't find together in any other git-based CMS.",
      "label": "Faster since 2.0",
      "title": "Publish. It's live.\nNo build to wait for.",
      "text": "Every publish is still a git commit, but your site doesn't wait for CI. It picks up the new content straight away. Skip builds for content-only commits and revalidate after each publish, and editors never wait on a deploy again.",
      "checks": [
        {
          "_id": "3JjOvlCbfqtfJRQgTSWPG7kkkgb",
          "_index": "a0",
          "_type": "Item",
          "text": "Content syncs to your running site on every commit"
        },
        {
          "_id": "3JjOvpiuDNx3c5gLru8ss88irfa",
          "_index": "a1",
          "_type": "Item",
          "text": "Content-only commits can skip the rebuild entirely"
        },
        {
          "_id": "3JjOvkoP5Rz7JVNyAyCcOhMYj9A",
          "_index": "a2",
          "_type": "Item",
          "text": "Code changes still deploy the way they always have"
        }
      ],
      "link": {
