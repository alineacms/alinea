      "items": [
        {
          "_id": "3JjQ45v3rUvSr5OSg3CtPQ9R6ys",
          "_index": "a0",
          "_type": "Question",
          "question": "Do I need Alinea Cloud to use Alinea?",
          "answer": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "No. Alinea only needs a Node.js environment and a git repository. To invite other people you need somewhere to manage users, sign-in and drafts. You can run that yourself, or let Alinea Cloud handle it."
                }
              ]
            }
          ]
        },
        {
          "_id": "3JjQ4A5V2Ue7eJCQw00hJVB3VAP",
          "_index": "a1",
          "_type": "Question",
          "question": "Does Alinea Cloud host my website?",
          "answer": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "No. Your website and dashboard stay hosted by you, wherever you deploy them today. Alinea Cloud only handles sign-in, drafts and publishing to your GitHub repository."
                }
              ]
            }
          ]
        },
        {
          "_id": "3JjQ4D4qIltbtj8wqxtv5o37aSe",
          "_index": "a2",
          "_type": "Question",
          "question": "What will Alinea Cloud cost after the beta?",
          "answer": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "[Add pricing after the beta, and how much notice people get.]"
                }
              ]
            }
          ]
        },
        {
          "_id": "3JjQ4BfQj2tTgrs4170dL3bUzHY",
          "_index": "a3",
          "_type": "Question",
          "question": "What happens to my content if I stop using it?",
          "answer": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "Your published content lives in your own repository, so it stays yours. You can switch to running your own backend instead at any time."
                }
              ]
            }
          ]
        }
      ]
    }
