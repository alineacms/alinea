{
  "_id": "2YWqKUTrANlgEFMyBUEYdih2HpP",
  "_type": "Doc",
  "_index": "a0",
  "title": "Quickstart",
  "navigationTitle": "",
  "body": [
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Add Alinea to a Next.js project in a few steps. Prefer to let your coding agent do the work? Paste this prompt into Claude Code, Cursor or Codex and it follows the "
        },
        {
          "_type": "text",
          "text": "AI-assisted setup guide",
          "marks": [
            {
              "_type": "link",
              "_id": "3JjtxNdx25tc4K2H6ucc7uuRVET",
              "_link": "entry",
              "_entry": "3JjtPxuJN2K4q6JhBgqfqIzNCX4"
            }
          ]
        },
        {
          "_type": "text",
          "text": "."
        }
      ]
    },
    {
      "_type": "CopyPromptBlock",
      "_id": "3JjtxQAWdy9VI3aU1YeY0iajumi",
      "prompt": "Read https://alineacms.com/start.md and help me add Alinea to my Next.js project"
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "1. Set up Next.js"
        }
      ],
      "_anchor": "1-setup-next-js"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Create a new Next.js project in a directory of your choice. To add Alinea to an existing project, skip to step 2. Alinea's Next.js integration uses the App Router and requires Node.js 24 or higher and React 19."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "2YXL5zGSUUiBumPIemixlnKqCyL",
      "code": "npx create-next-app@latest",
      "fileName": "",
      "language": "shellscript",
      "compact": false
    },
    {
      "_type": "NoticeBlock",
      "_id": "2YXKZ3Ds2lpGOsLh9adsGaBQlTx",
      "level": "info",
      "body": [
        {
          "_type": "paragraph",
          "content": [
            {
              "_type": "text",
              "text": "Read the full instructions in the "
            },
            {
              "_type": "text",
              "text": "Next.js docs",
              "marks": [
                {
                  "_type": "link",
                  "_id": "3Jjz4I59ZsA5VUQkeOR2NhEtlKD",
                  "_link": "url",
                  "href": "https://nextjs.org/docs/getting-started/installation"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "2. Install Alinea"
        }
      ],
      "_anchor": "2-install-alinea"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Navigate to the newly created project directory and install the package with your preferred package manager."
        }
      ]
    },
    {
      "_type": "CodeVariantsBlock",
      "_id": "2YcqwSzePKnvF6rL4bu9cI0d4LN",
      "variants": [
        {
          "_id": "2Ycqwgl3s7szk2B92gnXY5unG3Q",
          "_index": "a0",
          "_type": "Variant",
          "name": "npm",
          "language": "shellscript",
          "code": "npm install alinea"
        },
        {
          "_id": "2YcqyQsBjtLQbXB3v9l7AtdcH3U",
          "_index": "a1",
          "_type": "Variant",
          "name": "yarn",
          "language": "shellscript",
          "code": "yarn add alinea"
        },
        {
          "_id": "2YcqzHpnfHK43fhtMEY6r7Wrpf1",
          "_index": "a2",
          "_type": "Variant",
          "name": "pnpm",
          "language": "shellscript",
          "code": "pnpm add alinea"
        },
        {
          "_id": "2nvByMUmxNTiXafJjyx1NimzTVv",
          "_index": "a3",
          "_type": "Variant",
          "name": "bun",
          "language": "shellscript",
          "code": "bun add alinea"
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "3. Initialize the project"
        }
      ],
      "_anchor": "3-initialize-the-project"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Alinea requires a "
        },
        {
          "_type": "text",
          "text": "config file",
          "marks": [
            {
              "_type": "link",
              "_id": "2a4tfP6guQMwWKKRhiN0Nb5JeQN",
              "_link": "entry",
              "_entry": "259Ey7LXgqL7ZDGJ8XK1vBJmZrh"
            }
          ]
        },
        {
          "_type": "text",
          "text": " which can be auto-generated by running `alinea init`. If you prefer plain JavaScript over TypeScript, rename the created file from `cms.ts` to `cms.js`."
        }
      ]
    },
    {
      "_type": "CodeVariantsBlock",
      "_id": "2YcrGI2EPnmmIrHkfo1xKrcNVSI",
      "variants": [
        {
          "_id": "2YcrGaP9oBJwHo8pWmHLU7blTfN",
          "_index": "a0",
          "_type": "Variant",
          "name": "npm",
          "language": "shellscript",
          "code": "npx alinea init"
        },
        {
          "_id": "2YcrHzKowUENzFVBgP5M7hf1qT1",
          "_index": "a1",
          "_type": "Variant",
          "name": "yarn",
          "language": "shellscript",
          "code": "yarn alinea init"
        },
        {
          "_id": "2YcrJEDLa8oWOLJSSjsstOKg4Sl",
          "_index": "a2",
          "_type": "Variant",
          "name": "pnpm",
          "language": "shellscript",
          "code": "pnpm alinea init"
        },
        {
          "_id": "2nvC5Pfk9WeObDYgbSL8GkJ0OZu",
          "_index": "a3",
          "_type": "Variant",
          "name": "bun",
          "language": "shellscript",
          "code": "bun alinea init"
        }
      ]
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "In a Next.js project `alinea init` sets up everything the dashboard needs:"
        }
      ]
    },
    {
      "_type": "bulletList",
      "content": [
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "`cms.ts` (in `src/` if your project has a `src` directory) holds your schema, workspaces and settings such as `baseUrl`, `handlerUrl: '/api/cms'` and `adminPath: '/admin'`."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "`app/(alinea)/api/cms/route.ts` is the API route the dashboard talks to. It passes your `cms` to `createHandler` from `alinea/next`. It imports `@/cms`, so check that the `@/*` path alias in `tsconfig.json` points to the folder that holds `cms.ts`."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "`content/pages/welcome.json` is a first entry, and `content/media` holds uploaded files."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "The `dev` and `build` scripts in `package.json` are rewritten to run through Alinea: `next dev` becomes `alinea dev -- next dev` and `next build` becomes `alinea build -- next build`."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "4. Adjust Next.js config"
        }
      ],
      "_anchor": "4-adjust-next-js-config"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Wrap your Next.js config with `withAlinea`. It serves the dashboard on your site at `adminPath`, forwards media file requests, and keeps the generated content package out of the server bundle:"
        }
      ]
    },
    {
      "_type": "CodeVariantsBlock",
      "_id": "2bRC6LC1i4PfMRTFBeXuHrvWjk0",
      "variants": [
        {
          "_id": "2bRCBQoR8tqmnewVSC95tvRYmFk",
          "_index": "Zz",
          "_type": "Variant",
          "name": "next.config.ts",
          "language": "tsx",
          "code": "import {withAlinea} from 'alinea/next'\nimport type {NextConfig} from 'next'\n\nconst nextConfig: NextConfig = {\n  // Your Next.js options\n}\n\nexport default withAlinea(nextConfig)"
        },
        {
          "_id": "2bRC6k9IXwZsgnaBLqqWcybH8H9",
          "_index": "a0",
          "_type": "Variant",
          "name": "next.config.js",
          "language": "tsx",
          "code": "const {withAlinea} = require('alinea/next')\n\nconst nextConfig = {\n  // Your Next.js options\n}\n\nmodule.exports = withAlinea(nextConfig)"
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "5. Start the dev server"
        }
      ],
      "_anchor": "5-start-the-dev-server"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Congratulations, Alinea is now ready to boot! Start your dev script:"
        }
      ]
    },
    {
      "_type": "CodeVariantsBlock",
      "_id": "2YcsowsEWLDCcidcKeyJrTKCEOg",
      "variants": [
        {
          "_id": "2YcspJhldAQ2xaUIDqKHbWHrtSz",
          "_index": "a0",
          "_type": "Variant",
          "name": "npm",
          "language": "shellscript",
          "code": "npm run dev"
        },
        {
          "_id": "2YcsqDyTPJFoUeSjn6ZYJpcdWix",
          "_index": "a1",
          "_type": "Variant",
          "name": "yarn",
          "language": "shellscript",
          "code": "yarn dev"
        },
        {
          "_id": "2YcsrOH1ImdTgzQ3C4nWULoN0lQ",
          "_index": "a2",
          "_type": "Variant",
          "name": "pnpm",
          "language": "shellscript",
          "code": "pnpm dev"
        },
        {
          "_id": "2nvS0mDMAOjffEPMa3RJpL5rzUe",
          "_index": "a3",
          "_type": "Variant",
          "name": "bun",
          "language": "shellscript",
          "code": "bun run dev"
        }
      ]
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "The script runs `alinea dev -- next dev`: Alinea compiles `cms.ts`, starts its local server and then starts `next dev` with the settings `withAlinea` needs. Open the dashboard at "
        },
        {
          "_type": "text",
          "text": "http://localhost:3000/admin",
          "marks": [
            {
              "_type": "link",
              "_id": "3Jjz4GXy0GxtLxteCks98rK6KMO",
              "_link": "url",
              "href": "http://localhost:3000/admin"
            }
          ]
        },
        {
          "_type": "text",
          "text": " and have a look around."
        }
      ]
    },
    {
      "_type": "NoticeBlock",
      "_id": "3Jjz4GWS3PoZ6pwb4ypMLrws6Yi",
      "level": "info",
      "body": [
        {
          "_type": "paragraph",
          "content": [
            {
              "_type": "text",
              "text": "Running `npx alinea dev` on its own only starts the local dashboard on http://localhost:4500, not your site. Keep the `alinea dev -- next dev` form in your dev script so both run together and the dashboard is served from your Next.js app. The same goes for `alinea build -- next build`, which generates your content before the site is built."
            }
          ]
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "6. Enable live previews"
        }
      ],
      "_anchor": "6-enable-live-previews"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "To see the page you are editing next to the editor, set `preview: true` in `cms.ts` (`alinea init` leaves it commented out) and render the preview component in your root layout:"
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "3Jjz4JFngpAsuuqaXtRx4G9eQbm",
      "code": "import {cms} from '@/cms'\n\nexport default function RootLayout({children}: {children: React.ReactNode}) {\n  return (\n    <html lang=\"en\">\n      <body>\n        {children}\n        <cms.previews widget />\n      </body>\n    </html>\n  )\n}",
      "fileName": "app/layout.tsx",
      "language": "tsx"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "The `widget` prop adds a small toolbar to your pages to switch to the dashboard, read more in "
        },
        {
          "_type": "text",
          "text": "Live previews",
          "marks": [
            {
              "_type": "link",
              "_id": "3Jjz4FSC8LV54BCrbC3UgOCAUhg",
              "_link": "entry",
              "_entry": "2YlBsRF2vZwxcS27oOSJYmQM37q"
            }
          ]
        },
        {
          "_type": "text",
          "text": "."
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Next steps"
        }
      ],
      "_anchor": "next-steps"
    },
    {
      "_type": "bulletList",
      "content": [
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "Define your content types in the "
                },
                {
                  "_type": "text",
                  "text": "schema",
                  "marks": [
                    {
                      "_type": "link",
                      "_id": "3Jjz4LHdmycZnZdR3Eqs5ea1Bv5",
                      "_link": "entry",
                      "_entry": "267KTV8uPHIdZgFUQvJf06sfm4h"
                    }
                  ]
                },
                {
                  "_type": "text",
                  "text": " and pick "
                },
                {
                  "_type": "text",
                  "text": "fields",
                  "marks": [
                    {
                      "_type": "link",
                      "_id": "3Jjz4JwHPFHqJJMuttpgyLkvNCZ",
                      "_link": "entry",
                      "_entry": "24yE2mu6Xq959jrP135Sdb4e3lG"
                    }
                  ]
                },
                {
                  "_type": "text",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "Render content in your pages with "
                },
                {
                  "_type": "text",
                  "text": "queries",
                  "marks": [
                    {
                      "_type": "link",
                      "_id": "3Jjz4HQuY5Z8xw6QmR3bcekQ4eP",
                      "_link": "entry",
                      "_entry": "3AZCsyar65l8ytkp44ZL2C4aCG2"
                    }
                  ]
                },
                {
                  "_type": "text",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "Follow the "
                },
                {
                  "_type": "text",
                  "text": "tutorial",
                  "marks": [
                    {
                      "_type": "link",
                      "_id": "3Jjz4KJD4dJIw6rrKXrCpMeJtnj",
                      "_link": "entry",
                      "_entry": "3AONCC6cssRWNTfGBx86XSB2Exn"
                    }
                  ]
                },
                {
                  "_type": "text",
                  "text": " to build a complete site."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "Deploy",
                  "marks": [
                    {
                      "_type": "link",
                      "_id": "3Jjz4L9hnUYxi7JfVufEgK9Rx2u",
                      "_link": "entry",
                      "_entry": "28NgMpMQkmTy4uyFhPj8z4XVqml"
                    }
                  ]
                },
                {
                  "_type": "text",
                  "text": " your site with a backend for publishing."
                }
              ]
            }
          ]
        }
      ]
    }
  ],
