{
  "_id": "2YlBsRF2vZwxcS27oOSJYmQM37q",
  "_type": "Doc",
  "_index": "a0",
  "title": "Live previews",
  "navigationTitle": "",
  "body": [
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "You can set up a live preview of your website inside the dashboard."
        }
      ]
    },
    {
      "_id": "3JjflSkQHtGkdnGtjYCD52QKgyq",
      "_type": "ImageBlock",
      "image": {
        "_id": "3JjflRflm91E2wRpkpdzWTYGn3F",
        "_type": "image",
        "_index": "",
        "_entry": "3JjekoQez3OJmuOiJSZ37tE5JDo"
      },
      "darkImage": {
        "_id": "3JjflOMFNob3ZlaVosZsxIXTaNF",
        "_type": "image",
        "_index": "",
        "_entry": "3JjeksPO46LakWub1Kw2JxvvpGV"
      },
      "caption": "Editing a product in the Oak & Loom demo, with the page previewed live beside the form."
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Update your "
        },
        {
          "_type": "text",
          "text": "CMS config",
          "marks": [
            {
              "_type": "link",
              "_id": "2YlC927lwX5hfm2G9JHx9j3yRux",
              "_link": "entry",
              "_entry": "259Ey7LXgqL7ZDGJ8XK1vBJmZrh"
            }
          ]
        },
        {
          "_type": "text",
          "text": " to enable live previews:"
        }
      ]
    },
    {
      "_id": "2YlCBIFhktYqXLnxlG8MWbFhkA4",
      "_type": "CodeBlock",
      "code": "import {createCMS} from 'alinea/next'\n\nexport const cms = createCMS({\n  // schema and workspaces ...\n  baseUrl: {\n    // Point this url to your Next.js website\n    development: 'http://localhost:3000'\n  },\n  preview: true\n})",
      "fileName": "cms.ts",
      "language": "",
      "compact": false
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Include the preview widget (`<cms.previews />`) in your root layout:"
        }
      ]
    },
    {
      "_id": "2YlDBfC8A8tt3H8vaxKz1JZuov8",
      "_type": "CodeBlock",
      "code": "import {cms} from '@/cms'\nimport type {PropsWithChildren} from 'react'\n\nexport default async function Layout({children}: PropsWithChildren) {\n  return (\n    <>\n      <header />\n      <main>{children}</main>\n      <footer />\n      <cms.previews widget />\n    </>\n  )\n}",
      "fileName": "app/layout.tsx",
      "language": "",
      "compact": false
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "This will enable a little widget at the bottom of the page that confirms to the editor they're looking at a preview of the page. If you don't want a preview widget but do want live previews, remove the `widget` prop."
        }
      ]
    }
  ],
