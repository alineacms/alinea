{
  "_id": "2aiM9Z6hrhingqGxBX6GGKEVBAh",
  "_type": "Doc",
  "_index": "a2d",
  "title": "Url",
  "navigationTitle": "",
  "body": [
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "A url field holds a link to an external resource: a website, a `mailto:` or `tel:` link, a social profile. Editors enter the url, an optional title and whether it opens in a new tab. For links that can also point to pages in the CMS, use the "
        },
        {
          "_type": "text",
          "text": "Link field",
          "marks": [
            {
              "_type": "link",
              "_id": "3JkF05zhmkWFw49iJ7CYEcptjhV",
              "_link": "entry",
              "_entry": "24yE79dE2ssYPDQQHFFgT0eg2tH"
            }
          ]
        },
        {
          "_type": "text",
          "text": "."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "2aiMCRN0CLmhmeDTiClxqD0dIxf",
      "code": "import {Field} from 'alinea'\n\nField.url('Website')\n\nField.url.multiple('Social profiles', {max: 5})",
      "fileName": "",
      "language": "tsx"
    },
    {
      "_type": "ExampleBlock",
      "_id": "2aiMFdnqKQucL7haTVJQfqtcsVs",
      "code": "import {Config, Field} from 'alinea'\n\nexport default Config.type('Url field', {\n  fields: {\n    url: Field.url('Website'),\n    urlMultiple: Field.url.multiple('Social profiles', {max: 5})\n  }\n})"
    },
    {
      "_type": "heading",
      "textAlign": "start",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Options"
        }
      ],
      "_anchor": "options"
    },
    {
      "_type": "bulletList",
      "content": [
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "`fields`: extra fields stored on each link, such as a label or an icon choice. Pass an object of fields or a type."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "`max` (multiple only): the maximum number of links."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "The "
                },
                {
                  "_type": "text",
                  "text": "common options",
                  "marks": [
                    {
                      "_type": "link",
                      "_id": "3JkEzzz6Kus6svHbw2ACdCpLxkc",
                      "_link": "entry",
                      "_entry": "24yE2mu6Xq959jrP135Sdb4e3lG"
                    }
                  ]
                },
                {
                  "_type": "text",
                  "text": " `help`, `width`, `inline`, `initialValue`, `required`, `validate`, `readOnly`, `hidden` and `shared`."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_type": "heading",
      "textAlign": "start",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Value"
        }
      ],
      "_anchor": "value"
    },
    {
      "_type": "paragraph",
      "textAlign": "start",
      "content": [
        {
          "_type": "text",
          "text": "Each link is resolved to `{href, title, target, fields}`: `href` holds the url as entered, `target` is `'_blank'` when the editor chose a new tab and `'_self'` otherwise, and `fields` holds your extra fields. A single url field is `null` while it's empty, a multiple one is an array."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "3JkF02uI4lTKh0KHad2EvPUy50a",
      "code": "import type {UrlLink} from 'alinea'\n\nexport function ExternalLink({link}: {link: UrlLink | null}) {\n  if (!link?.href) return null\n  return (\n    <a\n      href={link.href}\n      target={link.target || undefined}\n      rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}\n    >\n      {link.title || link.href}\n    </a>\n  )\n}",
      "fileName": "",
      "language": "tsx"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "The picker only checks that the url can be parsed, so relative urls such as `/contact` are accepted too. Add a `validate` function if you need a specific format, for example urls that start with `https://`."
        }
      ]
    }
  ],
