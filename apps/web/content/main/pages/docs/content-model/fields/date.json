{
  "_id": "A4UA9D0tJn2aanMDjODOj",
  "_type": "Doc",
  "_index": "a2B",
  "title": "Date & time",
  "navigationTitle": "",
  "body": [
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "`Field.date` holds a calendar date and `Field.time` a time of day. Both store plain strings without a timezone, which makes them easy to compare, filter and sort."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "utmfOtYpwki29ZXEW5QPX",
      "code": "import {Field} from 'alinea'\n\nField.date('Publish date')\nField.time('Start time', {minValue: '08:00', maxValue: '18:00'})",
      "fileName": "",
      "language": "tsx"
    },
    {
      "_type": "ExampleBlock",
      "_id": "RHKsNdTj50LX0TFLU2_QH",
      "code": "import {Config, Field} from 'alinea'\n\nexport default Config.type('Date/time field', {\n  fields: {\n    date: Field.date('Date', {width: 0.5}),\n    time: Field.time('Start time', {\n      width: 0.5,\n      minValue: '08:00',\n      maxValue: '18:00'\n    })\n  }\n})"
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Options"
        }
      ],
      "_anchor": "configuration"
    },
    {
      "_type": "bulletList",
      "content": [
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "`minValue` and `maxValue` (time only): the earliest and latest time an editor can enter, as `HH:mm`."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "The "
                },
                {
                  "_type": "text",
                  "text": "common options",
                  "marks": [
                    {
                      "_type": "link",
                      "_id": "3JkEzvN8XkIW3F57wNYxghjbj6X",
                      "_link": "entry",
                      "_entry": "24yE2mu6Xq959jrP135Sdb4e3lG"
                    }
                  ]
                },
                {
                  "_type": "text",
                  "text": " `help`, `width`, `inline`, `initialValue`, `required`, `validate`, `readOnly`, `hidden` and `shared`."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Value"
        }
      ],
      "_anchor": "initialvalue"
    },
    {
      "_type": "bulletList",
      "content": [
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "A date is stored as an ISO date string, `'2026-09-23'`. The dashboard shows it in day-month-year order."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "A time is stored as `'HH:mm'` on a 24-hour clock, `'14:30'`."
                }
              ]
            }
          ]
        },
        {
          "_type": "listItem",
          "content": [
            {
              "_type": "paragraph",
              "content": [
                {
                  "_type": "text",
                  "text": "Both are empty until an editor picks a value, unless you set an `initialValue`."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Because the format sorts alphabetically in date order, you can filter and sort on these fields directly:"
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "3JkEzuxHM4h2BFaJI4m6ZOY6Ukz",
      "code": "import {cms} from '@/cms'\nimport {Event} from '@/schema'\n\nconst today = new Date().toISOString().slice(0, 10)\n\nconst upcoming = await cms.find({\n  type: Event,\n  filter: {date: {gte: today}},\n  orderBy: {asc: Event.date}\n})",
      "fileName": "",
      "language": "tsx"
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Default to today"
        }
      ],
      "_anchor": "default-to-today"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "`initialValue` takes a fixed string. Compute today's date in your config: it's evaluated when the dashboard loads, so new entries get the date the editor opened the dashboard."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "3AqgFyQjZ6mumpYHEsTjtqcC3hm",
      "code": "import {Field} from 'alinea'\n\nconst today = new Date().toISOString().slice(0, 10)\nField.date('Publish date', {initialValue: today})",
      "fileName": "",
      "language": "tsx"
    },
    {
      "_type": "ExampleBlock",
      "_id": "3AqgIWUxshIAbuao0ObLey8g60Q",
      "code": "import {Config, Field} from 'alinea'\n\nconst today = new Date().toISOString().slice(0, 10)\n\nexport default Config.type('Date (initialValue)', {\n  fields: {\n    date: Field.date('Publish date', {initialValue: today})\n  }\n})"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "If the creation date matters, entries made with "
        },
        {
          "_type": "text",
          "text": "`Config.document`",
          "marks": [
            {
              "_type": "link",
              "_id": "3JkEzx5xoMmwyVKtPgL4rpNBik8",
              "_link": "entry",
              "_entry": "2aAyRD3ixey0IqznGhiPUjTd5Vp"
            }
          ]
        },
        {
          "_type": "text",
          "text": " already record it: query `Query.createdAt`."
        }
      ]
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Formatting"
        }
      ],
      "_anchor": "formatting"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "`new Date('2026-09-23')` is midnight UTC, which is still the previous day in timezones west of UTC. Format stored dates in UTC to show the date the editor picked:"
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "3JkEzrO6OPxdeHTE1GcBXTixLHO",
      "code": "export function formatDate(date: string, locale = 'en-US') {\n  return new Date(date).toLocaleDateString(locale, {\n    dateStyle: 'long',\n    timeZone: 'UTC'\n  })\n}",
      "fileName": "",
      "language": "tsx"
    }
  ],
