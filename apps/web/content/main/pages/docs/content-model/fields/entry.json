{
  "_id": "2aiLjrXSg8gyirKnw9LmYKwsW2O",
  "_type": "Doc",
  "_index": "a2Y",
  "title": "Entry",
  "navigationTitle": "",
  "body": [
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "The entry field can be used to link to an internal page."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "2aiLnCCudPz6D0aNgADlzuObGEs",
      "code": "import {Field} from 'alinea'\n\nField.entry('Single entry link')\n\nField.entry.multiple('Multiple entry links')",
      "fileName": "",
      "language": ""
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Configuration"
        }
      ],
      "_anchor": "configuration"
    },
    {
      "_type": "heading",
      "level": 3,
      "content": [
        {
          "_type": "text",
          "text": "`condition`"
        }
      ],
      "_anchor": "condition"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Limit the pages shown in the explorer to this condition. Conditions can be built using fields in the same way as described in the "
        },
        {
          "_type": "text",
          "text": "filtering",
          "marks": [
            {
              "_type": "link",
              "_id": "3JjzBZtSiXNhy68eXqXZw2kWLoh",
              "_link": "entry",
              "_entry": "3AZJ7caQ7xN9oe18v57EGVm19Yz"
            }
          ]
        },
        {
          "_type": "text",
          "text": " chapter."
        }
      ]
    },
    {
      "_type": "blockquote",
      "content": [
        {
          "_type": "paragraph",
          "textAlign": "left",
          "content": [
            {
              "_type": "text",
              "text": "`_status`: \"archived\" | \"draft\" | \"published\""
            },
            {
              "_type": "hardBreak"
            },
            {
              "_type": "text",
              "text": "Filter entries by publication status."
            }
          ]
        },
        {
          "_type": "paragraph",
          "textAlign": "left",
          "content": [
            {
              "_type": "text",
              "text": "`_type`"
            },
            {
              "_type": "hardBreak"
            },
            {
              "_type": "text",
              "text": "Filter entries by content type."
            }
          ]
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "2aiNY0EOVAiPH085iK0NelgMfhO",
      "code": "import {Field} from 'alinea'\n\nField.entry('Link to author', {\n  condition: {\n    _type: 'Author'\n  }\n})\n\nField.entry('Link to author or writer', {\n  condition: {\n    _type: {\n      in: ['Author', 'Writer']\n    }\n  }\n})",
      "fileName": "",
      "language": ""
    },
    {
      "_type": "heading",
      "level": 3,
      "content": [
        {
          "_type": "text",
          "text": "`defaultView`"
        }
      ],
      "_anchor": "defaultview"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Preset the UI to show rows or thumbnails (possible values: \"row\", \"thumb\")"
        }
      ]
    },
    {
      "_type": "heading",
      "level": 3,
      "content": [
        {
          "_type": "text",
          "text": "`inline`"
        }
      ],
      "_anchor": "inline"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Show a minimal version of the field. The field label is hidden."
        }
      ]
    },
    {
      "_type": "heading",
      "level": 3,
      "content": [
        {
          "_type": "text",
          "text": "`location`"
        }
      ],
      "_anchor": "location"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Defines the location (workspace and root) in which the entry picker opens."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "31uIXMVpPme7rebYzsJ4FOz59oH",
      "code": "import {Field} from 'alinea'\n\nField.entry('Link to author', {\n  location: {\n    root: 'pages',\n    workspace: 'main'\n  }\n})",
      "fileName": "",
      "language": ""
    },
    {
      "_type": "heading",
      "level": 3,
      "content": [
        {
          "_type": "text",
          "text": "`pickChildren`"
        }
      ],
      "_anchor": "pickchildren"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Choose from a flat list of direct children of the currently edited entry."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "3F2KF8Sa4vaurAfq6kaysKq1Und",
      "code": "import {Field} from 'alinea'\n\nField.entry('Author of this book', {\n  condition: {\n    _type: 'Author'\n  },\n  pickChildren: true\n})",
      "fileName": "",
      "language": ""
    },
    {
      "_type": "heading",
      "level": 3,
      "content": [
        {
          "_type": "text",
          "text": "`max`"
        }
      ],
      "_anchor": "max"
    },
    {
      "_type": "paragraph",
      "textAlign": "left",
      "content": [
        {
          "_type": "text",
          "text": "Limit the amount of rows in case of multiple links."
        }
      ]
    },
    {
      "_type": "CodeBlock",
      "_id": "3F2GKxhpocJf8ZPxaLD6HBOUXot",
      "code": "import {Field} from 'alinea'\n\nField.entry.multiple('Select up to 3 authors', {\n  max: 3\n})",
      "fileName": "",
      "language": ""
    }
  ],
