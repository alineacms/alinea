          "_type": "text",
          "text": "Accessibility"
        }
      ],
      "_anchor": "accessibility"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "Built on the React Aria grid: the arrow keys move between rows, Space selects a row and Enter runs its action. Sortable column headers announce their sort direction."
        }
