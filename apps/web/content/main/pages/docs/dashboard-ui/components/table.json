          "_type": "text",
          "text": "Selection and sorting"
        }
      ],
      "_anchor": "selection-and-sorting"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "Set a `selectionMode` to let editors select rows, `showSelectionControls` adds a checkbox to every row. Mark columns as `sortable` and sort the items in `onSortChange`."
        }
      ]
    },
