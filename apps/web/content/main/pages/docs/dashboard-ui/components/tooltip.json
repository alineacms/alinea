      "content": [
        {
          "_type": "text",
          "text": "Accessibility"
        }
      ],
      "_anchor": "accessibility"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "The tooltip describes its trigger with `aria-describedby`. It opens on keyboard focus as well as on hover and closes with Escape. An icon-only trigger still needs an `aria-label`."
        }
      ]
    }
