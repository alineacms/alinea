  "title": "Tooltip",
  "navigationTitle": "",
  "body": [
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "A short description that appears when its trigger is hovered or focused. Use it to name icon-only buttons, not for information editors need to do their work."
        }
      ]
    },
