          "text": "Props"
        }
      ],
      "_anchor": "props"
    },
    {
      "_type": "ComponentPropsBlock",
      "_id": "3JmLPZ7h0qjT6sWiaq1r8DZilFX",
      "component": "Tabs"
    },
    {
      "_type": "heading",
      "level": 2,
      "content": [
        {
          "_type": "text",
          "text": "Accessibility"
        }
      ],
      "_anchor": "accessibility"
    },
    {
      "_type": "paragraph",
      "content": [
        {
          "_type": "text",
          "text": "The arrow keys move between tabs, Home and End jump to the first and last one. Only the selected tab is in the tab order, so Tab moves on to its content."
        }
      ]
    }
