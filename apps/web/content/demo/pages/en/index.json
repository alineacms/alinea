      "title": "Every joint cut, fitted and oiled by hand",
      "text": [
        {
          "_type": "paragraph",
          "content": [
            {
              "_type": "text",
              "text": "We are a team of seven makers in a former textile mill in Ghent. We work with wood from forests that are managed to last, and we build each piece to order, so nothing waits in a warehouse."
            }
          ]
        },
        {
          "_type": "paragraph",
          "content": [
            {
              "_type": "text",
              "text": "It takes longer. We think it's worth it."
            }
          ]
        }
